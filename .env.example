# Secrets — set in Cloudflare with: wrangler secret put NAME
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
RESEND_API_KEY=re_...
RUN_SECRET=change-me-to-a-long-random-string

# Vars (also configurable in wrangler.toml [vars])
OPENAI_MODEL=gpt-4.1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
WORKER_TIMEZONE=America/New_York
MIN_SCRIPT_WORDS=3300
TARGET_SCRIPT_WORDS_MIN=3300
TARGET_SCRIPT_WORDS_MAX=3700
MAX_SCRIPT_WORDS=3900
WORDS_PER_MINUTE=145
MAX_TTS_CHARS_PER_CHUNK=2500
ENABLE_EMAIL=true
ENABLE_SOURCE_DIGEST=true
ENABLE_REPAIR_PASS=true
STRIP_PACING_TAGS_FOR_TTS=true
STATUS_PUBLIC=false

EMAIL_FROM=The Penny Tribune <morningcup@yourdomain.com>
EMAIL_TO=your-email@example.com

# Optional: a public R2 base URL (custom domain or r2.dev) for email links
R2_PUBLIC_BASE_URL=https://media.yourdomain.com

# ElevenLabs voice settings overrides
VOICE_STABILITY=0.35
VOICE_SIMILARITY_BOOST=0.85
VOICE_STYLE=0.7
VOICE_USE_SPEAKER_BOOST=true

# Optional news source providers (sourceDigest.ts wires these in)
NEWS_RSS_FEEDS=https://feeds.reuters.com/reuters/topNews,https://feeds.apnews.com/rss/topNews
NEWSAPI_KEY=
NEWSAPI_ENDPOINT=https://newsapi.org/v2/top-headlines
